# Bezpečnostné nastavenia
Options -Indexes
# Všetky textové súbory sú UTF-8 – deklaruj to aj v HTTP hlavičke.
AddDefaultCharset UTF-8
ServerSignature Off
# Self-hosted WOFF2 (css/fonts.css → /fonts/*.woff2)
AddType font/woff2 .woff2
# SIL OFL license texts (hosting blocks .txt; use .ofl)
AddType text/plain .ofl

# Globálne bezpečnostné HTTP hlavičky
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Povolené zdroje zahŕňajú aj analytiku načítavanú až po súhlase.
    # Fonty sú self-hosted (/css/fonts.css + /fonts/*.woff2); Google Fonts hosty odstránené 2026-11-05.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://scripts.clarity.ms https://fastbase.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://polascin.net https://clustrmaps.com https://www.google.sk https://www.google.com https://www.google-analytics.com https://*.clarity.ms https://c.bing.com; frame-src 'self' https://sk.polascin.net; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://stats.g.doubleclick.net https://*.clarity.ms https://fastbase.com https://*.fastbase.com"
    # Report-Only: nič neblokuje. Meria cestu k prísnejšiemu script-src ('self' bez
    # unsafe-inline/Clarity/GTM/Fastbase). Fonty self-hosted; ClustrMaps ostáva
    # povolené, kým ich nelokalizujeme. media/frame same-origin podľa auditu
    # 2026-11-05 (žiadne data: obrázky, žiadne sk.polascin iframes v markup).
    # NEPREENÁŠAŤ do vynucovanej CSP bez samostatného schválenia.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://polascin.net https://clustrmaps.com; frame-src 'self'; media-src 'self'; connect-src 'self'"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Blokovanie .git a citlivých súborov
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|pem|key|p12|pfx|log|sql|bak)$">
    Require all denied
</FilesMatch>

# Lokálne dev konfigy (PHPStan, PHP-CS-Fixer) — len lokálny vývoj, nie cez web
<FilesMatch "^(phpstan.*|\.php-cs-fixer.*)$">
    Require all denied
</FilesMatch>

# Interné Markdown dokumenty (.agent.md, AGENTS.md, README, …) — nie cez web
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

RewriteEngine on

# Interné include fragmenty sa vkladajú cez PHP include zo súborového systému;
# priamy prístup cez HTTP nie je nikdy potrebný (obrana do hĺbky).
RewriteRule ^(?:blocks|segments)/ - [F,L]

# Alias bez prípony: /privacy a /terms → kanonické HTML v /files/
# (privacy.php/terms.php už samy 301-ujú sem; alias ide priamo, bez reťazenia).
RewriteRule ^(privacy|terms)/?$ /files/$1.html [R=301,L,NE]

# Obsahové fragmenty majú vlastné stránky; staré URL na ne presmeruj.
RewriteRule ^files/(dialyza|nefrologia|purifikacia|transplantacia|usgo|nefamb|lipton-tx)\.html$ /$1.php [R=301,L]

# Enforce one canonical HTTPS hostname for stronger SEO canonicalization.
# Zrušená doména nephro.site (a akýkoľvek iný Host) → 301 na nephrosite.polascin.net.
RewriteCond %{HTTP_HOST} !^nephrosite\.polascin\.net$ [NC,OR]
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://nephrosite.polascin.net%{REQUEST_URI} [L,R=301]

SetEnvIf Request_URI "^/blocks/" noindex_path=1
SetEnvIf Request_URI "^/segments/" noindex_path=1
SetEnvIf Request_URI "^/ipvrm\.files/" noindex_path=1

<IfModule mod_headers.c>
	Header set X-Robots-Tag "noindex, nofollow, noarchive" env=noindex_path
</IfModule>
