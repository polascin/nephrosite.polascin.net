# Bezpečnostné nastavenia
Options -Indexes
# Všetky textové súbory sú UTF-8 – deklaruj to aj v HTTP hlavičke.
AddDefaultCharset UTF-8
ServerSignature Off
# Self-hosted WOFF2 (css/fonts.css → /fonts/*.woff2)
AddType font/woff2 .woff2
# SIL OFL license texts (hosting blocks .txt; use .ofl)
AddType text/plain .ofl

# Globálne bezpečnostné HTTP hlavičky
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Povolené zdroje zahŕňajú aj analytiku načítavanú až po súhlase.
    # Fonty sú self-hosted (/css/fonts.css + /fonts/*.woff2); Google Fonts hosty odstránené 2026-11-05.
    # ClustrMaps: lokálny SVG snapshot (/pix/clustrmaps-visitor-map.svg); host clustrmaps.com odstránený 2026-11-05.
    # CSP reporting: first-party /csp-report.php (group "csp"); report-uri pre Safari/Firefox,
    # report-to + Reporting-Endpoints pre Chromium Reporting API.
    Header always set Reporting-Endpoints "csp=\"/csp-report.php\""
    # Hybrid CSP: static HTML/assets keep Apache CSP below. PHP HTML entrypoints
    # emit request-scoped CSP via blocks/csp-bootstrap.php (Report-Only nonce).
    # Do not "Header always set" CSP globally for *.php — that would duplicate or
    # race the PHP headers (and "always unset" would strip PHP-set CSP too).
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # Static documents/assets: enforced + Report-Only (no request nonce possible).
    # Keep in sync with nephrosite_csp_enforced_policy() /
    # nephrosite_csp_report_only_policy(false) in blocks/csp-bootstrap.php.
    <FilesMatch "\.(html?|css|js|mjs|svg|woff2|png|jpe?g|gif|ico|webp|pdf|mp4|ofl|xml|txt|map)$">
        Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://scripts.clarity.ms https://fastbase.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://polascin.net https://www.google.sk https://www.google.com https://www.google-analytics.com https://*.clarity.ms https://c.bing.com; frame-src 'self' https://sk.polascin.net; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://stats.g.doubleclick.net https://*.clarity.ms https://fastbase.com https://*.fastbase.com; report-uri /csp-report.php; report-to csp"
        # Report-Only: nič neblokuje. Meria cestu k prísnejšiemu script-src ('self'
        # bez unsafe-inline/Clarity/GTM/Fastbase). PHP pages also send RO with a
        # matching 'nonce-…' via csp-bootstrap.php.
        # NEPREENÁŠAŤ do vynucovanej CSP bez samostatného schválenia.
        Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https://polascin.net; frame-src 'self'; media-src 'self'; connect-src 'self'; report-uri /csp-report.php; report-to csp"
    </FilesMatch>

    # Long-lived cache for content-hashed / rarely changing first-party assets
    # (self-hosted fonts after loop #5). Filenames are stable; bump path on change.
    <FilesMatch "\.(woff2|ofl)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(fonts\.css|tokens\.css|legal\.css|privacy-consent\.js|clustrmaps-visitor-map\.svg)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Blokovanie .git a citlivých súborov
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|pem|key|p12|pfx|log|sql|bak)$">
    Require all denied
</FilesMatch>

# Lokálne dev konfigy (PHPStan, PHP-CS-Fixer) — len lokálny vývoj, nie cez web
<FilesMatch "^(phpstan.*|\.php-cs-fixer.*)$">
    Require all denied
</FilesMatch>

# Interné Markdown dokumenty (.agent.md, AGENTS.md, README, …) — nie cez web
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

RewriteEngine on

# Interné include fragmenty sa vkladajú cez PHP include zo súborového systému;
# priamy prístup cez HTTP nie je nikdy potrebný (obrana do hĺbky).
RewriteRule ^(?:blocks|segments)/ - [F,L]

# Kanonické čisté URL (loop #10): /privacy, /terms a témy bez .php.
# Externé 301 len pre staré cesty; cieľové URL sa servírujú interným rewriteom
# (200 bez hopu), aby kotvy (#legal-disclaimer) a crawl ostali stabilné.

# .php témy → čistá URL (THE_REQUEST, aby interný rewrite nespustil slučku).
RewriteCond %{THE_REQUEST} \s/+(dialyza|nefrologia|purifikacia|transplantacia|usgo|nefamb|lipton-tx)\.php[\s?] [NC]
RewriteRule ^(dialyza|nefrologia|purifikacia|transplantacia|usgo|nefamb|lipton-tx)\.php$ /$1 [R=301,L]

# Staré /files/*.html (témy + právne) → čisté URL.
RewriteRule ^files/(dialyza|nefrologia|purifikacia|transplantacia|usgo|nefamb|lipton-tx)\.html$ /$1 [R=301,L]
RewriteRule ^files/(privacy|terms)\.html$ /$1 [R=301,L,NE]

# Čisté URL → interné ciele (bez R=).
RewriteRule ^(privacy|terms)/?$ /files/$1.html [L,NE]
RewriteRule ^(dialyza|nefrologia|purifikacia|transplantacia|usgo|nefamb|lipton-tx)/?$ /$1.php [L]

# Enforce one canonical HTTPS hostname for stronger SEO canonicalization.
# Zrušená doména nephro.site (a akýkoľvek iný Host) → 301 na nephrosite.polascin.net.
RewriteCond %{HTTP_HOST} !^nephrosite\.polascin\.net$ [NC,OR]
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://nephrosite.polascin.net%{REQUEST_URI} [L,R=301]

SetEnvIf Request_URI "^/blocks/" noindex_path=1
SetEnvIf Request_URI "^/segments/" noindex_path=1
SetEnvIf Request_URI "^/ipvrm\.files/" noindex_path=1

<IfModule mod_headers.c>
	Header set X-Robots-Tag "noindex, nofollow, noarchive" env=noindex_path
</IfModule>
